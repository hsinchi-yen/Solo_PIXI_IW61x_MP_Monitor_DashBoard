DATABASE_URL=postgresql://pixi:pixipass@postgres:5432/pixi_test
IW_API_PORT=8003
IW_WEB_PORT=8004
IW_DB_PORT=5434
POSTGRES_DB=pixi_test
POSTGRES_USER=pixi
POSTGRES_PASSWORD=pixipass
APP_VERSION=2.0.0
APP_TZ=Asia/Taipei

# Administrator (DB Tweak, planned quantities, accounts). Uploader accounts are created on the
# Accounts page. Sessions are stored in the database (no signing secret).
# Change ADMIN_PASS on any shared server.
ADMIN_USER=pixi
ADMIN_PASS=pixipass
SESSION_TTL_HOURS=8
# Extra browser origins allowed to call the API directly, comma separated (empty = same origin only)
CORS_ORIGINS=

# AI (upload assistant, quality reports, follow-up questions). Off unless both are set.
LLM_ENABLED=false
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=Qwen3.8-27B-UD-Q6_K_L
LLM_ENABLE_THINKING=false
LLM_REPORT_MAX_TOKENS=1536
# Reports are generated after each web upload and once a day at this local time.
REPORT_AUTO=true
REPORT_DAILY_AT=18:00

# Statistics are refreshed on this interval (seconds) and right after web uploads / deletes.
STATS_REFRESH_SEC=300
DB_POOL_MAX=8
